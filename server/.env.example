# ===============================================================
# Smart Nutrition Planner - Backend Environment Configuration
# ===============================================================

# Port for Express API server
PORT=5000

# MongoDB Connection URI (Local instance or MongoDB Atlas cloud URI)
# Example for local: mongodb://127.0.0.1:27017/nutrition_planner
# Example for Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/nutrition_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nutrition_planner

# Optional: USDA FoodData Central API Key for external ingredient queries
# Free key can be generated at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY
